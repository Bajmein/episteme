{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "mcp__episteme__search",
      "mcp__episteme__read",
      "mcp__episteme__links",
      "mcp__episteme__review",
      "mcp__episteme__context",
      "mcp__episteme__surface",
      "mcp__episteme__constraints",
      "mcp__episteme__docs_status",
      "mcp__episteme__session",
      "mcp__episteme__plan",
      "Bash(uv run --no-project --python 3.14 python -I <SESION_SCRIPT> *)"
    ],
    "deny": [
      "Read(~/.episteme/**)",
      "Edit(~/.episteme/**)",
      "Bash(obsidian *)",
      "Bash(omega *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "episteme",
            "tool": "context",
            "input": {
              "mode": "welcome",
              "session": "${session_id}",
              "prompt": "${prompt}",
              "hook_event": "${hook_event_name}"
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|mcp__serena__.*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "episteme",
            "tool": "constraints",
            "input": {
              "file": "${tool_input.file_path}",
              "relative_path": "${tool_input.relative_path}",
              "project_dir": "${cwd}",
              "hook_event": "${hook_event_name}"
            }
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "episteme",
            "tool": "plan",
            "input": {
              "action": "save",
              "plan": "${tool_input.plan}",
              "plan_path": "${tool_input.planFilePath}",
              "session": "${session_id}",
              "project_dir": "${cwd}",
              "hook_event": "${hook_event_name}"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|mcp__serena__.*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "episteme",
            "tool": "surface",
            "input": {
              "file": "${tool_input.file_path}",
              "relative_path": "${tool_input.relative_path}",
              "project_dir": "${cwd}",
              "hook_event": "${hook_event_name}",
              "session": "${session_id}"
            }
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "episteme",
            "tool": "session",
            "input": {
              "action": "gate",
              "trigger": "${trigger}",
              "session": "${session_id}",
              "project_dir": "${cwd}",
              "hook_event": "${hook_event_name}"
            }
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "episteme",
            "tool": "session",
            "input": {
              "action": "capture",
              "summary": "${compact_summary}",
              "session": "${session_id}",
              "project_dir": "${cwd}",
              "hook_event": "${hook_event_name}"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "episteme",
            "tool": "session",
            "input": {
              "action": "end",
              "transcript": "${transcript_path}",
              "reason": "${reason}",
              "hook_event": "${hook_event_name}"
            }
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "episteme",
            "tool": "session",
            "input": {
              "action": "restore",
              "source": "${source}",
              "transcript": "${transcript_path}",
              "session": "${session_id}",
              "project_dir": "${cwd}",
              "hook_event": "${hook_event_name}"
            }
          },
          {
            "type": "mcp_tool",
            "server": "episteme",
            "tool": "plan",
            "input": {
              "action": "restore",
              "source": "${source}",
              "project_dir": "${cwd}",
              "session": "${session_id}",
              "hook_event": "${hook_event_name}"
            }
          },
          {
            "type": "mcp_tool",
            "server": "episteme",
            "tool": "context",
            "input": {
              "mode": "welcome",
              "session": "${session_id}",
              "hook_event": "${hook_event_name}",
              "source": "${source}"
            }
          }
        ]
      }
    ]
  }
}
